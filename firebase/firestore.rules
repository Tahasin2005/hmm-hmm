rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL SAFETY NET (Default Deny)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // HARDENED GLOBAL PRIMITIVES
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin check without DB reads (safe for list queries)
    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'tahasinahammed58@gmail.com';
    }

    // Full RBAC admin check (trusted server-managed admins collection + bootstrapped owner)
    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(u) {
      return u is string && u.size() >= 3 && u.size() <= 20 && u.matches('^[a-z0-9_]+$');
    }

    function isValidReactionType(t) {
      return t in ['like', 'love', 'care', 'haha', 'wow', 'sad', 'angry'];
    }

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isNotBlockedEither(a, b) {
      return !exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
        && !exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    // =========================================================================
    // ENTITY VALIDATION BLUEPRINTS
    // =========================================================================
    function isValidUserProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'name', 'username', 'bio', 'avatarUrl', 'avatarColor',
          'location', 'visibility', 'friendRequestPref',
          'followersCount', 'followingCount', 'friendsCount', 'postsCount',
          'isSuspended', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'username', 'bio', 'avatarUrl', 'avatarColor',
          'location', 'jobTitle', 'workplace', 'birthDate', 'socialLinks',
          'coverPhotoUrl', 'isVerified', 'visibility', 'friendRequestPref',
          'followersCount', 'followingCount', 'friendsCount', 'postsCount',
          'isSuspended', 'role', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid) && data.uid == uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && isValidUsername(data.username)
        && data.bio is string && data.bio.size() <= 280
        && data.avatarUrl is string && data.avatarUrl.size() <= 160000
        && data.avatarColor is string && data.avatarColor.size() >= 1 && data.avatarColor.size() <= 32
        && data.location is string && data.location.size() <= 80
        && (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() <= 80))
        && (!('workplace' in data) || (data.workplace is string && data.workplace.size() <= 100))
        && (!('birthDate' in data) || (data.birthDate is string && data.birthDate.size() <= 20))
        && (!('socialLinks' in data) || (data.socialLinks is list && data.socialLinks.size() <= 10))
        && (!('coverPhotoUrl' in data) || (data.coverPhotoUrl is string && data.coverPhotoUrl.size() <= 350000))
        && (!('isVerified' in data) || data.isVerified is bool)
        && (data.visibility == 'public' || data.visibility == 'friends')
        && (data.friendRequestPref == 'everyone' || data.friendRequestPref == 'none')
        && data.followersCount is int && data.followersCount >= 0
        && data.followingCount is int && data.followingCount >= 0
        && data.friendsCount is int && data.friendsCount >= 0
        && data.postsCount is int && data.postsCount >= 0
        && data.isSuspended is bool
        && (!('role' in data) || data.role in ['member', 'admin'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateAccount(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && isValidId(data.uid) && data.uid == uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.updatedAt is timestamp;
    }

    function isValidUsernameReservation(data, username) {
      return data.keys().hasAll(['uid', 'username', 'createdAt'])
        && data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && isValidId(data.uid)
        && isValidUsername(data.username) && data.username == username
        && data.createdAt is timestamp;
    }

    function isValidPost(data, postId) {
      return data.keys().hasAll([
          'postId', 'authorId', 'authorName', 'authorUsername',
          'authorAvatarUrl', 'authorAvatarColor', 'text', 'visibility',
          'likesCount', 'commentsCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'postId', 'authorId', 'authorName', 'authorUsername',
          'authorAvatarUrl', 'authorAvatarColor', 'authorRole', 'text', 'visibility',
          'postType', 'embedProvider', 'embedUrl', 'embedAspect',
          'taggedUsers', 'hashtags', 'mentions',
          'likesCount', 'commentsCount', 'sharesCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.postId) && data.postId == postId
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && isValidUsername(data.authorUsername)
        && data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 160000
        && data.authorAvatarColor is string && data.authorAvatarColor.size() >= 1 && data.authorAvatarColor.size() <= 32
        && (!('authorRole' in data) || data.authorRole in ['member', 'admin'])
        && data.text is string && data.text.size() <= 2000
        && (
          data.text.size() >= 1 ||
          ('postType' in data && data.postType == 'embed' && 'embedUrl' in data && data.embedUrl is string && data.embedUrl.size() >= 10)
        )
        && (!('postType' in data) || data.postType in ['text', 'embed'])
        && (!('embedProvider' in data) || data.embedProvider in ['', 'youtube', 'facebook', 'vimeo'])
        && (!('embedUrl' in data) || (data.embedUrl is string && data.embedUrl.size() <= 2000))
        && (!('embedAspect' in data) || data.embedAspect in ['16:9', '9:16', '4:3', '1:1'])
        && (!('taggedUsers' in data) || (data.taggedUsers is list && data.taggedUsers.size() <= 20))
        && (!('hashtags' in data) || (data.hashtags is list && data.hashtags.size() <= 30))
        && (!('mentions' in data) || (data.mentions is list && data.mentions.size() <= 30))
        && data.visibility == 'public'
        && data.likesCount is int && data.likesCount >= 0
        && data.commentsCount is int && data.commentsCount >= 0
        && (!('sharesCount' in data) || (data.sharesCount is int && data.sharesCount >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidComment(data, commentId) {
      return data.keys().hasAll([
          'commentId', 'postId', 'authorId', 'authorName', 'authorUsername',
          'authorAvatarUrl', 'authorAvatarColor', 'text', 'visibility', 'createdAt'
        ])
        && data.keys().hasOnly([
          'commentId', 'postId', 'authorId', 'authorName', 'authorUsername',
          'authorAvatarUrl', 'authorAvatarColor', 'authorRole', 'text',
          'mentions', 'visibility', 'createdAt'
        ])
        && isValidId(data.commentId) && data.commentId == commentId
        && isValidId(data.postId)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && isValidUsername(data.authorUsername)
        && data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 160000
        && data.authorAvatarColor is string && data.authorAvatarColor.size() >= 1 && data.authorAvatarColor.size() <= 32
        && (!('authorRole' in data) || data.authorRole in ['member', 'admin'])
        && (!('mentions' in data) || (data.mentions is list && data.mentions.size() <= 20))
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.visibility == 'public'
        && data.createdAt is timestamp;
    }

    function isValidLike(data, likeId) {
      return data.keys().hasAll(['likeId', 'postId', 'userId', 'createdAt'])
        && data.keys().hasOnly([
          'likeId', 'postId', 'userId', 'reactionType',
          'userName', 'userUsername', 'userAvatarUrl', 'userAvatarColor',
          'userRole', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.likeId) && data.likeId == likeId
        && isValidId(data.postId)
        && isValidId(data.userId)
        && data.likeId == data.postId + '_' + data.userId
        && (!('reactionType' in data) || isValidReactionType(data.reactionType))
        && (!('userName' in data) || (data.userName is string && data.userName.size() <= 80))
        && (!('userUsername' in data) || (data.userUsername is string && data.userUsername.size() <= 30))
        && (!('userAvatarUrl' in data) || (data.userAvatarUrl is string && data.userAvatarUrl.size() <= 160000))
        && (!('userAvatarColor' in data) || (data.userAvatarColor is string && data.userAvatarColor.size() <= 32))
        && (!('userRole' in data) || data.userRole in ['member', 'admin'])
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidCommentReaction(data, reactionId) {
      return data.keys().hasAll(['reactionId', 'commentId', 'postId', 'userId', 'reactionType', 'createdAt'])
        && data.keys().hasOnly([
          'reactionId', 'commentId', 'postId', 'userId', 'reactionType',
          'userName', 'userUsername', 'userAvatarUrl', 'userAvatarColor',
          'userRole', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.reactionId) && data.reactionId == reactionId
        && isValidId(data.commentId)
        && isValidId(data.postId)
        && isValidId(data.userId)
        && data.reactionId == data.commentId + '_' + data.userId
        && isValidReactionType(data.reactionType)
        && (!('userName' in data) || (data.userName is string && data.userName.size() <= 80))
        && (!('userUsername' in data) || (data.userUsername is string && data.userUsername.size() <= 30))
        && (!('userAvatarUrl' in data) || (data.userAvatarUrl is string && data.userAvatarUrl.size() <= 160000))
        && (!('userAvatarColor' in data) || (data.userAvatarColor is string && data.userAvatarColor.size() <= 32))
        && (!('userRole' in data) || data.userRole in ['member', 'admin'])
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidBlock(data, blockId) {
      return data.keys().hasAll(['blockId', 'blockerId', 'blockedId', 'createdAt'])
        && data.keys().hasOnly([
          'blockId', 'blockerId', 'blockedId',
          'blockedName', 'blockedUsername', 'blockedAvatarUrl', 'blockedAvatarColor',
          'createdAt'
        ])
        && isValidId(data.blockId) && data.blockId == blockId
        && isValidId(data.blockerId)
        && isValidId(data.blockedId)
        && data.blockerId != data.blockedId
        && data.blockId == data.blockerId + '_' + data.blockedId
        && (!('blockedName' in data) || (data.blockedName is string && data.blockedName.size() <= 80))
        && (!('blockedUsername' in data) || (data.blockedUsername is string && data.blockedUsername.size() <= 30))
        && (!('blockedAvatarUrl' in data) || (data.blockedAvatarUrl is string && data.blockedAvatarUrl.size() <= 160000))
        && (!('blockedAvatarColor' in data) || (data.blockedAvatarColor is string && data.blockedAvatarColor.size() <= 32))
        && data.createdAt is timestamp;
    }

    function isValidAnnouncement(data, announcementId) {
      return data.keys().hasAll([
          'announcementId', 'title', 'message', 'authorId', 'authorName',
          'authorUsername', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'announcementId', 'title', 'message', 'imageUrl', 'linkUrl',
          'authorId', 'authorName', 'authorUsername', 'authorAvatarUrl',
          'authorAvatarColor', 'isActive', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.announcementId) && data.announcementId == announcementId
        && data.title is string && data.title.size() <= 140
        && data.message is string && data.message.size() <= 2000
        && (data.title.size() >= 1 || data.message.size() >= 1)
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 350000))
        && (!('linkUrl' in data) || (data.linkUrl is string && data.linkUrl.size() <= 500))
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && isValidUsername(data.authorUsername)
        && (!('authorAvatarUrl' in data) || (data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 160000))
        && (!('authorAvatarColor' in data) || (data.authorAvatarColor is string && data.authorAvatarColor.size() <= 32))
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFeedPromo(data, promoId) {
      return data.keys().hasAll([
          'promoId', 'promoType', 'intervalPosts', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'promoId', 'promoType', 'label', 'title', 'caption',
          'embedProvider', 'embedUrl', 'embedAspect',
          'imageUrl', 'ctaText', 'ctaUrl',
          'intervalPosts', 'isActive', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.promoId) && data.promoId == promoId
        && data.promoType in ['embed', 'image_ad', 'video', 'ad']
        && (!('label' in data) || (data.label is string && data.label.size() <= 40))
        && (!('title' in data) || (data.title is string && data.title.size() <= 140))
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 1000))
        && (!('embedProvider' in data) || data.embedProvider in ['', 'youtube', 'facebook', 'vimeo'])
        && (!('embedUrl' in data) || (data.embedUrl is string && data.embedUrl.size() <= 2000))
        && (!('embedAspect' in data) || data.embedAspect in ['16:9', '9:16', '4:3', '1:1'])
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 350000))
        && (!('ctaText' in data) || (data.ctaText is string && data.ctaText.size() <= 60))
        && (!('ctaUrl' in data) || (data.ctaUrl is string && data.ctaUrl.size() <= 500))
        && data.intervalPosts is int && data.intervalPosts >= 1 && data.intervalPosts <= 50
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFriendRequest(data, requestId) {
      return data.keys().hasAll(['requestId', 'senderId', 'receiverId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['requestId', 'senderId', 'receiverId', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.requestId) && data.requestId == requestId
        && isValidId(data.senderId)
        && isValidId(data.receiverId)
        && data.senderId != data.receiverId
        && data.requestId == data.senderId + '_' + data.receiverId
        && (data.status == 'pending' || data.status == 'accepted' || data.status == 'rejected' || data.status == 'cancelled')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFriendship(data, friendshipId) {
      return data.keys().hasAll(['friendshipId', 'user1Id', 'user2Id', 'participants', 'createdAt'])
        && data.keys().hasOnly(['friendshipId', 'user1Id', 'user2Id', 'participants', 'createdAt'])
        && isValidId(data.friendshipId) && data.friendshipId == friendshipId
        && isValidId(data.user1Id)
        && isValidId(data.user2Id)
        && data.user1Id < data.user2Id
        && data.friendshipId == data.user1Id + '_' + data.user2Id
        && data.participants is list
        && data.participants.size() == 2
        && data.participants[0] == data.user1Id
        && data.participants[1] == data.user2Id
        && data.createdAt is timestamp;
    }

    function isValidFollow(data, followId) {
      return data.keys().hasAll(['followId', 'followerId', 'followingId', 'createdAt'])
        && data.keys().hasOnly(['followId', 'followerId', 'followingId', 'createdAt'])
        && isValidId(data.followId) && data.followId == followId
        && isValidId(data.followerId)
        && isValidId(data.followingId)
        && data.followerId != data.followingId
        && data.followId == data.followerId + '_' + data.followingId
        && data.createdAt is timestamp;
    }

    function isValidNotification(data, notificationId) {
      return data.keys().hasAll([
          'notificationId', 'recipientId', 'senderId', 'senderName',
          'senderUsername', 'type', 'referenceId', 'message', 'isRead', 'createdAt'
        ])
        && data.keys().hasOnly([
          'notificationId', 'recipientId', 'senderId', 'senderName',
          'senderUsername', 'type', 'referenceId', 'message', 'isRead', 'isSeen', 'createdAt'
        ])
        && isValidId(data.notificationId) && data.notificationId == notificationId
        && isValidId(data.recipientId)
        && isValidId(data.senderId)
        && data.senderId != data.recipientId
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && isValidUsername(data.senderUsername)
        && data.type in ['friend_request', 'friend_accepted', 'like', 'comment', 'message', 'follow', 'mention', 'tag', 'vip_verified']
        && data.referenceId is string && data.referenceId.size() <= 128
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 240
        && data.isRead is bool
        && (!('isSeen' in data) || data.isSeen is bool)
        && data.createdAt is timestamp;
    }

    function isValidReport(data, reportId) {
      return data.keys().hasAll([
          'reportId', 'reporterId', 'targetType', 'targetId',
          'reason', 'details', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'reportId', 'reporterId', 'targetType', 'targetId',
          'reason', 'details', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.reportId) && data.reportId == reportId
        && isValidId(data.reporterId)
        && (data.targetType == 'post' || data.targetType == 'comment' || data.targetType == 'user')
        && isValidId(data.targetId)
        && (
          data.reason == 'Spam' ||
          data.reason == 'Harassment' ||
          data.reason == 'Hate speech' ||
          data.reason == 'Fake account' ||
          data.reason == 'Inappropriate content' ||
          data.reason == 'Other'
        )
        && data.details is string && data.details.size() <= 500
        && (data.status == 'open' || data.status == 'reviewed' || data.status == 'resolved' || data.status == 'dismissed')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrashItem(data, trashId) {
      return data.keys().hasAll([
          'trashId', 'itemType', 'originalId', 'originalCollection',
          'data', 'reason', 'category', 'flaggedBy', 'trashedAt', 'trashedBy'
        ])
        && data.keys().hasOnly([
          'trashId', 'itemType', 'originalId', 'originalCollection',
          'data', 'reason', 'category', 'flaggedBy', 'trashedAt', 'trashedBy'
        ])
        && isValidId(data.trashId) && data.trashId == trashId
        && data.itemType in ['post', 'comment']
        && isValidId(data.originalId)
        && data.originalCollection in ['posts', 'comments']
        && data.data is map
        && data.reason is string && data.reason.size() <= 500
        && data.category is string && data.category.size() <= 80
        && data.flaggedBy in ['ai', 'admin']
        && isValidId(data.trashedBy)
        && data.trashedAt is timestamp;
    }

    function isValidSiteConfig(data) {
      return data.keys().hasOnly([
          'siteName', 'tagline', 'logoUrl', 'faviconUrl',
          'metaDescription', 'metaKeywords', 'primaryAdminUid', 'updatedAt'
        ])
        && (!('siteName' in data) || (data.siteName is string && data.siteName.size() >= 1 && data.siteName.size() <= 80))
        && (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 140))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 250000))
        && (!('faviconUrl' in data) || (data.faviconUrl is string && data.faviconUrl.size() <= 150000))
        && (!('metaDescription' in data) || (data.metaDescription is string && data.metaDescription.size() <= 320))
        && (!('metaKeywords' in data) || (data.metaKeywords is string && data.metaKeywords.size() <= 320))
        && (!('primaryAdminUid' in data) || (data.primaryAdminUid is string && data.primaryAdminUid.size() <= 128))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // =========================================================================
    // SITE CONFIG (Public Branding & SEO — Strictly Zero PII / Zero Secrets)
    // =========================================================================
    match /siteConfig/{docId} {
      allow get: if docId == 'general';
      allow list: if false;
      allow create, update: if isAdmin() && docId == 'general' && isValidSiteConfig(incoming());
      allow delete: if isAdmin() && docId == 'general';
    }

    // =========================================================================
    // ADMIN CONFIG (AI Moderation Settings & API Key — Strictly Admin Only)
    // =========================================================================
    match /adminConfig/{docId} {
      allow get: if isAdmin() && docId == 'aiModeration';
      allow list: if false;
      allow create, update: if isAdmin() && docId == 'aiModeration'
        && incoming().keys().hasOnly(['enabled', 'apiKey', 'model', 'lastScanAt', 'lastScanSummary', 'updatedAt'])
        && (!('enabled' in incoming()) || incoming().enabled is bool)
        && (!('apiKey' in incoming()) || (incoming().apiKey is string && incoming().apiKey.size() <= 256))
        && (!('model' in incoming()) || (incoming().model is string && incoming().model.size() <= 80))
        && (!('lastScanSummary' in incoming()) || (incoming().lastScanSummary is string && incoming().lastScanSummary.size() <= 300));
      allow delete: if isAdmin() && docId == 'aiModeration';
    }

    // =========================================================================
    // TRASH (AI & Admin Moderation Recycle Bin — Strictly Admin Only)
    // =========================================================================
    match /trash/{trashId} {
      allow get: if isAdmin() && isValidId(trashId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(trashId) && isValidTrashItem(incoming(), trashId);
      allow update: if false;
      allow delete: if isAdmin() && isValidId(trashId);
    }

    // =========================================================================
    // ANNOUNCEMENTS (Global Home Feed Announcements — Admin Write, Signed-In Read)
    // =========================================================================
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && isValidId(announcementId) && isValidAnnouncement(incoming(), announcementId);
      allow update: if isAdmin() && isValidId(announcementId) && isValidAnnouncement(incoming(), announcementId);
      allow delete: if isAdmin() && isValidId(announcementId);
    }

    // =========================================================================
    // FEED PROMOS (Admin Anonymous In-Feed Videos & Ads — Signed-In Read)
    // =========================================================================
    match /feedPromos/{promoId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && isValidId(promoId) && isValidFeedPromo(incoming(), promoId);
      allow update: if isAdmin() && isValidId(promoId) && isValidFeedPromo(incoming(), promoId);
      allow delete: if isAdmin() && isValidId(promoId);
    }

    // =========================================================================
    // BLOCKS (User-to-User Two-Way Blocking)
    // =========================================================================
    match /blocks/{blockId} {
      allow get: if isSignedIn() && isValidId(blockId) && (
        resource == null ||
        existing().blockerId == request.auth.uid ||
        existing().blockedId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.blockerId == request.auth.uid ||
        resource.data.blockedId == request.auth.uid ||
        isBootstrappedAdmin()
      );
      allow create: if isVerifiedUser()
        && isValidId(blockId)
        && isValidBlock(incoming(), blockId)
        && incoming().blockerId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(blockId) && (
        existing().blockerId == request.auth.uid ||
        isAdmin()
      );
    }

    // =========================================================================
    // USERS (Public Profile — PII Isolated)
    // =========================================================================
    match /users/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (
        resource == null ||
        isOwner(uid) ||
        existing().visibility == 'public' ||
        exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid))) ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.uid == request.auth.uid ||
        isBootstrappedAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(uid)
        && isOwner(uid)
        && isValidUserProfile(incoming(), uid)
        && (!('role' in incoming()) || incoming().role == 'member' || isAdmin())
        && incoming().followersCount == 0
        && incoming().followingCount == 0
        && incoming().friendsCount == 0
        && incoming().postsCount == 0
        && incoming().isSuspended == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == uid;

      allow update: if isVerifiedUser()
        && isValidId(uid)
        && (!('uid' in existing()) || incoming().uid == existing().uid)
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['friendsCount'])
            && incoming().friendsCount is number && incoming().friendsCount >= 0
            && (
              (
                incoming().friendsCount == (('friendsCount' in existing() ? existing().friendsCount : 0) + 1)
                && (
                  isOwner(uid) ||
                  isAdmin() ||
                  existsAfter(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid)))
                )
              ) || (
                ('friendsCount' in existing() ? existing().friendsCount : 0) > 0
                && incoming().friendsCount == existing().friendsCount - 1
                && (
                  isOwner(uid) ||
                  isAdmin() ||
                  !existsAfter(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid)))
                )
              )
            )
          ) ||
          (
            (isOwner(uid) || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly(['postsCount'])
            && incoming().postsCount is number && incoming().postsCount >= 0
            && (
              incoming().postsCount == (('postsCount' in existing() ? existing().postsCount : 0) + 1) ||
              (('postsCount' in existing() ? existing().postsCount : 0) > 0 && incoming().postsCount == existing().postsCount - 1)
            )
          ) ||
          (
            (isOwner(uid) || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly(['followingCount'])
            && incoming().followingCount is number && incoming().followingCount >= 0
            && (
              incoming().followingCount == (('followingCount' in existing() ? existing().followingCount : 0) + 1) ||
              (('followingCount' in existing() ? existing().followingCount : 0) > 0 && incoming().followingCount == existing().followingCount - 1)
            )
          ) ||
          (
            (!isOwner(uid) || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount'])
            && incoming().followersCount is number && incoming().followersCount >= 0
            && (
              (
                incoming().followersCount == (('followersCount' in existing() ? existing().followersCount : 0) + 1)
                && (existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)) || isAdmin())
              ) || (
                ('followersCount' in existing() ? existing().followersCount : 0) > 0
                && incoming().followersCount == existing().followersCount - 1
                && (!existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)) || isAdmin())
              )
            )
          ) ||
          (
            (
              isAdmin() ||
              (isOwner(uid) && 'isVerified' in existing() && existing().isVerified == true)
            )
            && incoming().diff(existing()).affectedKeys().hasOnly(['coverPhotoUrl', 'updatedAt'])
            && incoming().coverPhotoUrl is string && incoming().coverPhotoUrl.size() <= 350000
            && incoming().updatedAt == request.time
          ) ||
          (
            (isOwner(uid) || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly(['avatarUrl', 'updatedAt'])
            && incoming().avatarUrl is string && incoming().avatarUrl.size() <= 160000
            && incoming().updatedAt == request.time
          ) ||
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['isSuspended', 'isVerified', 'role', 'postsCount', 'updatedAt'])
            && (!('isVerified' in incoming()) || incoming().isVerified is bool)
          ) ||
          (
            isOwner(uid)
            && isValidUserProfile(incoming(), uid)
            && existing().isSuspended == false
            && incoming().isSuspended == existing().isSuspended
            && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'username', 'bio', 'avatarUrl', 'avatarColor',
                'location', 'jobTitle', 'workplace', 'birthDate', 'socialLinks',
                'visibility', 'friendRequestPref', 'updatedAt'
              ]) ||
              (
                (isAdmin() || ('isVerified' in existing() && existing().isVerified == true))
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'name', 'username', 'bio', 'avatarUrl', 'avatarColor',
                  'location', 'jobTitle', 'workplace', 'birthDate', 'socialLinks',
                  'coverPhotoUrl', 'visibility', 'friendRequestPref', 'updatedAt'
                ])
              )
            )
            && incoming().updatedAt == request.time
            && getAfter(/databases/$(database)/documents/usernames/$(incoming().username)).data.uid == uid
          ) ||
          (
            isAdmin()
            && isValidUserProfile(incoming(), uid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'username', 'bio', 'avatarUrl', 'avatarColor',
              'location', 'jobTitle', 'workplace', 'birthDate', 'socialLinks',
              'coverPhotoUrl', 'isVerified', 'visibility', 'friendRequestPref', 'updatedAt'
            ])
            && incoming().updatedAt == request.time
          )
        );

      allow delete: if isVerifiedUser() && isValidId(uid) && (isOwner(uid) || isAdmin());

      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(uid) && docId == 'account' && (isOwner(uid) || isAdmin());
        allow list: if false;
        allow create: if isVerifiedUser()
          && isValidId(uid)
          && docId == 'account'
          && isOwner(uid)
          && isValidUserPrivateAccount(incoming(), uid)
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(uid)
          && docId == 'account'
          && isOwner(uid)
          && isValidUserPrivateAccount(incoming(), uid)
          && incoming().uid == existing().uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          && incoming().updatedAt == request.time;
        allow delete: if isVerifiedUser() && isValidId(uid) && docId == 'account' && (isOwner(uid) || isAdmin());
      }
    }

    // =========================================================================
    // USERNAMES
    // =========================================================================
    match /usernames/{username} {
      allow get: if isSignedIn() && isValidUsername(username);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidUsername(username)
        && isValidUsernameReservation(incoming(), username)
        && (incoming().uid == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidUsername(username) && (existing().uid == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // POSTS
    // =========================================================================
    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId) && (
        resource == null ||
        existing().visibility == 'public' ||
        existing().authorId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn();

      allow create: if isVerifiedUser()
        && isValidId(postId)
        && isValidPost(incoming(), postId)
        && (!('authorRole' in incoming()) || incoming().authorRole == 'member' || isAdmin())
        && (
          (
            incoming().authorId == request.auth.uid
            && incoming().likesCount == 0
            && incoming().commentsCount == 0
            && (!('sharesCount' in incoming()) || incoming().sharesCount == 0)
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ) ||
          isAdmin()
        );

      allow update: if isVerifiedUser()
        && isValidId(postId)
        && incoming().postId == existing().postId
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && (
          (
            existing().authorId == request.auth.uid
            && isValidPost(incoming(), postId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'hashtags', 'mentions', 'updatedAt'])
            && incoming().updatedAt == request.time
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
            && incoming().likesCount is int && incoming().likesCount >= 0
            && (
              (
                incoming().likesCount == (('likesCount' in existing() ? existing().likesCount : 0) + 1)
                && (existsAfter(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid)) || isAdmin())
              ) || (
                ('likesCount' in existing() ? existing().likesCount : 0) > 0
                && incoming().likesCount == existing().likesCount - 1
                && (!existsAfter(/databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid)) || isAdmin())
              )
            )
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount'])
            && incoming().commentsCount is int && incoming().commentsCount >= 0
            && (
              incoming().commentsCount == (('commentsCount' in existing() ? existing().commentsCount : 0) + 1) ||
              (('commentsCount' in existing() ? existing().commentsCount : 0) > 0 && incoming().commentsCount == existing().commentsCount - 1)
            )
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount'])
            && incoming().sharesCount is int && incoming().sharesCount >= 0
            && incoming().sharesCount == (('sharesCount' in existing() ? existing().sharesCount : 0) + 1)
          ) ||
          (isAdmin() && isValidPost(incoming(), postId))
        );

      allow delete: if isVerifiedUser() && isValidId(postId) && (existing().authorId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // COMMENTS
    // =========================================================================
    match /comments/{commentId} {
      allow get: if isSignedIn() && isValidId(commentId) && (
        resource == null ||
        existing().visibility == 'public' ||
        existing().authorId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.authorId == request.auth.uid ||
        isBootstrappedAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(commentId)
        && isValidComment(incoming(), commentId)
        && (!('authorRole' in incoming()) || incoming().authorRole == 'member' || isAdmin())
        && (
          (
            incoming().authorId == request.auth.uid
            && incoming().createdAt == request.time
            && exists(/databases/$(database)/documents/posts/$(incoming().postId))
          ) ||
          isAdmin()
        );

      allow update: if false;

      allow delete: if isVerifiedUser() && isValidId(commentId) && (existing().authorId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // LIKES / POST REACTIONS
    // =========================================================================
    match /likes/{likeId} {
      allow get: if isSignedIn() && isValidId(likeId);
      allow list: if isSignedIn();

      allow create: if isVerifiedUser()
        && isValidId(likeId)
        && isValidLike(incoming(), likeId)
        && (incoming().userId == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/posts/$(incoming().postId));

      allow update: if isVerifiedUser()
        && isValidId(likeId)
        && isValidLike(incoming(), likeId)
        && (existing().userId == request.auth.uid || isAdmin())
        && incoming().userId == existing().userId
        && incoming().postId == existing().postId
        && incoming().likeId == existing().likeId
        && incoming().createdAt == existing().createdAt;

      allow delete: if isVerifiedUser() && isValidId(likeId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // COMMENT REACTIONS
    // =========================================================================
    match /commentReactions/{reactionId} {
      allow get: if isSignedIn() && isValidId(reactionId);
      allow list: if isSignedIn();

      allow create: if isVerifiedUser()
        && isValidId(reactionId)
        && isValidCommentReaction(incoming(), reactionId)
        && (incoming().userId == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/comments/$(incoming().commentId));

      allow update: if isVerifiedUser()
        && isValidId(reactionId)
        && isValidCommentReaction(incoming(), reactionId)
        && (existing().userId == request.auth.uid || isAdmin())
        && incoming().userId == existing().userId
        && incoming().commentId == existing().commentId
        && incoming().postId == existing().postId
        && incoming().reactionId == existing().reactionId
        && incoming().createdAt == existing().createdAt;

      allow delete: if isVerifiedUser() && isValidId(reactionId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // FRIEND REQUESTS (Block-Protected)
    // =========================================================================
    match /friendRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        resource == null ||
        existing().senderId == request.auth.uid ||
        existing().receiverId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isBootstrappedAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidFriendRequest(incoming(), requestId)
        && (incoming().senderId == request.auth.uid || isAdmin())
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isNotBlockedEither(incoming().senderId, incoming().receiverId)
        && exists(/databases/$(database)/documents/users/$(incoming().receiverId));

      allow update: if isVerifiedUser()
        && isValidId(requestId)
        && isValidFriendRequest(incoming(), requestId)
        && incoming().requestId == existing().requestId
        && incoming().senderId == existing().senderId
        && incoming().receiverId == existing().receiverId
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          (
            existing().status == 'pending' && (
              (existing().senderId == request.auth.uid && incoming().status == 'cancelled') ||
              (existing().receiverId == request.auth.uid && incoming().status == 'rejected') ||
              (
                existing().receiverId == request.auth.uid
                && incoming().status == 'accepted'
                && existsAfter(/databases/$(database)/documents/friendships/$(pairId(existing().senderId, existing().receiverId)))
              )
            )
          ) ||
          isAdmin()
        );

      allow delete: if isVerifiedUser() && isValidId(requestId) && (
        existing().senderId == request.auth.uid ||
        existing().receiverId == request.auth.uid ||
        isAdmin()
      );
    }

    // =========================================================================
    // FRIENDSHIPS
    // =========================================================================
    match /friendships/{friendshipId} {
      allow get: if isSignedIn() && isValidId(friendshipId) && (
        resource == null ||
        existing().user1Id == request.auth.uid ||
        existing().user2Id == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isBootstrappedAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(friendshipId)
        && isValidFriendship(incoming(), friendshipId)
        && (incoming().user1Id == request.auth.uid || incoming().user2Id == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && (isNotBlockedEither(incoming().user1Id, incoming().user2Id) || isAdmin())
        && exists(/databases/$(database)/documents/users/$(incoming().user1Id))
        && exists(/databases/$(database)/documents/users/$(incoming().user2Id));

      allow update: if isVerifiedUser()
        && isValidId(friendshipId)
        && isValidFriendship(incoming(), friendshipId)
        && incoming().friendshipId == existing().friendshipId
        && incoming().user1Id == existing().user1Id
        && incoming().user2Id == existing().user2Id
        && (existing().user1Id == request.auth.uid || existing().user2Id == request.auth.uid || isAdmin());

      allow delete: if isVerifiedUser() && isValidId(friendshipId) && (
        existing().user1Id == request.auth.uid ||
        existing().user2Id == request.auth.uid ||
        isAdmin()
      );
    }

    // =========================================================================
    // FOLLOWS (Block-Protected)
    // =========================================================================
    match /follows/{followId} {
      allow get: if isSignedIn() && isValidId(followId) && (
        resource == null ||
        existing().followerId == request.auth.uid ||
        existing().followingId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.followerId == request.auth.uid ||
        resource.data.followingId == request.auth.uid ||
        isBootstrappedAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(followId)
        && isValidFollow(incoming(), followId)
        && (incoming().followerId == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && isNotBlockedEither(incoming().followerId, incoming().followingId)
        && exists(/databases/$(database)/documents/users/$(incoming().followingId));

      allow update: if false;

      allow delete: if isVerifiedUser() && isValidId(followId) && (
        existing().followerId == request.auth.uid ||
        existing().followingId == request.auth.uid ||
        isAdmin()
      );
    }

    // =========================================================================
    // NOTIFICATIONS (Block-Protected)
    // =========================================================================
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (
        resource == null ||
        existing().recipientId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid ||
        isBootstrappedAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidNotification(incoming(), notificationId)
        && (incoming().senderId == request.auth.uid || isAdmin())
        && incoming().isRead == false
        && incoming().createdAt == request.time
        && isNotBlockedEither(incoming().senderId, incoming().recipientId)
        && exists(/databases/$(database)/documents/users/$(incoming().recipientId));

      allow update: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidNotification(incoming(), notificationId)
        && incoming().notificationId == existing().notificationId
        && incoming().recipientId == existing().recipientId
        && incoming().senderId == existing().senderId
        && incoming().createdAt == existing().createdAt
        && (
          (
            existing().recipientId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'isSeen'])
            && (!('isRead' in incoming().diff(existing()).affectedKeys()) || incoming().isRead == true)
            && (!('isSeen' in incoming().diff(existing()).affectedKeys()) || incoming().isSeen == true)
          ) ||
          isAdmin()
        );

      allow delete: if isVerifiedUser() && isValidId(notificationId) && (
        existing().recipientId == request.auth.uid ||
        isAdmin()
      );
    }

    // =========================================================================
    // REPORTS
    // =========================================================================
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (
        resource == null ||
        existing().reporterId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.reporterId == request.auth.uid ||
        isBootstrappedAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(reportId)
        && isValidReport(incoming(), reportId)
        && incoming().reporterId == request.auth.uid
        && reportId == request.auth.uid + '_' + incoming().targetType + '_' + incoming().targetId
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(reportId)
        && isValidReport(incoming(), reportId)
        && isAdmin()
        && existing().status != 'resolved'
        && existing().status != 'dismissed'
        && incoming().reportId == existing().reportId
        && incoming().reporterId == existing().reporterId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && incoming().updatedAt == request.time;

      allow delete: if isVerifiedUser() && isValidId(reportId) && isAdmin();
    }

    // =========================================================================
    // ADMINS (Server-Managed RBAC Registry — Zero Client Writes)
    // =========================================================================
    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if false;
      allow write: if false;
    }
  }
}
